<!-- AFL VIP Welcome Panel (tight square scorecard: stacked, clean, clickable + NO overlap + rank movement) -->
<style>
  .afl-welcome-wrap{ margin:0 0 12px 0; }

  .afl-welcome-panel{
    display:flex;
    align-items:center;
    gap:14px;
    padding:14px 16px;

    background:
      radial-gradient(900px 240px at 20% 10%, rgba(255,255,255,.07), transparent 60%),
      linear-gradient(180deg, rgba(22,18,16,.92) 0%, rgba(8,8,10,.90) 100%);

    border-radius:18px;
    border:1px solid rgba(200,162,74,.38);

    box-shadow:
      0 14px 34px rgba(0,0,0,.62),
      inset 0 1px 0 rgba(255,255,255,.06),
      inset 0 0 0 1px rgba(0,0,0,.35);

    position:relative;
    overflow:hidden;
  }

  .afl-welcome-panel::before{
    content:"";
    position:absolute;
    left:12px; right:12px; top:0;
    height:2px;
    background:linear-gradient(90deg, transparent, rgba(224,194,122,.9), transparent);
    opacity:.55;
  }

  .afl-welcome-logo{ flex:0 0 auto; }

  .afl-welcome-logo .afl-logo-wrap{
    width:58px; height:58px;
    border-radius:999px;
    padding:6px;

    background:
      radial-gradient(circle at 30% 25%, rgba(255,255,255,.22), transparent 45%),
      linear-gradient(180deg, rgba(200,162,74,.25) 0%, rgba(90,15,20,.25) 100%),
      rgba(0,0,0,.45);

    border:1px solid rgba(224,194,122,.55);
    box-shadow:
      0 10px 22px rgba(0,0,0,.55),
      inset 0 1px 0 rgba(255,255,255,.10);

    display:flex;
    align-items:center;
    justify-content:center;
  }

  .afl-welcome-text{
    flex:1 1 auto;
    min-width:0;
    padding-right:132px; /* extra buffer to avoid any visual collisions */
  }

  .afl-welcome-title{
    margin:0 0 4px 0;
    font-weight:900;
    font-size:18px;
    letter-spacing:.25px;
    color:#E9E3D4;
    text-shadow:0 1px 0 rgba(0,0,0,.65);
  }

  .afl-welcome-tagline{
    margin:0;
    font-size:12px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:rgba(233,227,212,.78);
  }

  .afl-welcome-sub{
    margin:6px 0 0 0;
    font-size:12px;
    color:rgba(233,227,212,.88);
  }

  /* === TIGHT SCORECARD (square-ish) === */
  .afl-scorecard{
    position:absolute;
    right:14px;
    top:50%;
    transform:translateY(-50%);

    display:block;
    text-decoration:none;
    cursor:pointer;
    user-select:none;

    width:98px;                 /* small bump prevents label/value collision */
    padding:9px 10px;
    border-radius:12px;

    background:
      radial-gradient(140px 80px at 20% 25%, rgba(255,255,255,.10), transparent 62%),
      linear-gradient(180deg, rgba(0,0,0,.62), rgba(0,0,0,.30));

    border:1px solid rgba(224,194,122,.55);

    box-shadow:
      0 12px 26px rgba(0,0,0,.58),
      inset 0 1px 0 rgba(255,255,255,.08);
  }

  .afl-scorecard:hover{
    border-color: rgba(224,194,122,.82);
    box-shadow:
      0 16px 30px rgba(0,0,0,.62),
      inset 0 1px 0 rgba(255,255,255,.10);
  }

  .afl-score-row{
    display:flex;
    align-items:center;         /* was baseline; center helps avoid weird font overlaps */
    justify-content:space-between;
    gap:8px;
    line-height:1;
  }

  .afl-score-row + .afl-score-row{ margin-top:6px; }

  .afl-score-kicker{
    font-size:9px;
    letter-spacing:.20em;
    text-transform:uppercase;
    color:rgba(224,194,122,.92);
    white-space:nowrap;
    flex:0 0 auto;
  }

  /* Right side of rank row: value + tiny movement indicator */
  .afl-rank-wrap{
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:5px;                    /* slightly tighter */
    min-width:0;
    flex:0 0 auto;
  }

  .afl-score-rank{
    font-weight:900;
    font-size:18px;
    letter-spacing:.3px;
    color:#E9E3D4;
    text-shadow:0 1px 0 rgba(0,0,0,.65);
    white-space:nowrap;
  }

  .afl-rank-delta{
    font-size:10px;             /* small */
    line-height:1;
    font-weight:900;
    letter-spacing:.02em;
    text-shadow:0 1px 0 rgba(0,0,0,.55);
    padding:0;                  /* no circle/badge */
    border:none;
    background:transparent;
    opacity:.95;
    min-width:10px;
    text-align:right;
    white-space:nowrap;
  }

  /* Correct semantics:
     up (green) when rank number DECREASES (better),
     down (red) when rank number INCREASES (worse) */
  .afl-rank-up{ color: rgba(120, 255, 170, .95); }
  .afl-rank-down{ color: rgba(255, 120, 120, .95); }
  .afl-rank-flat{ color: rgba(224,194,122,.92); }

  .afl-score-pts{
    font-weight:800;
    font-size:13px;
    letter-spacing:.2px;
    color:rgba(233,227,212,.96);
    text-shadow:0 1px 0 rgba(0,0,0,.65);
    white-space:nowrap;
  }

  .afl-score-divider{
    height:1px;
    margin:7px 0 6px 0;
    background:linear-gradient(90deg, transparent, rgba(224,194,122,.35), transparent);
    opacity:.9;
  }

  /* Mobile tighten */
  @media (max-width: 520px){
    .afl-welcome-panel{
      padding:10px 12px;
      gap:10px;
      border-radius:14px;
    }
    .afl-welcome-logo .afl-logo-wrap{
      width:44px; height:44px;
      padding:5px;
    }
    .afl-welcome-title{ font-size:16px; margin-bottom:3px; }
    .afl-welcome-tagline{
      font-size:10px;
      letter-spacing:.14em;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .afl-welcome-sub{ margin-top:4px; font-size:11px; }

    .afl-welcome-text{ padding-right:120px; }

    .afl-scorecard{
      right:10px;
      width:92px;               /* mobile width */
      padding:8px 9px;
      border-radius:11px;
    }

    /* Key fix: shorten RANK label -> RK on mobile so it can never collide */
    .afl-score-kicker.rank-kicker{
      font-size:0;              /* hide text */
      letter-spacing:0;
    }
    .afl-score-kicker.rank-kicker::after{
      content:"RK";
      font-size:9px;
      letter-spacing:.20em;
      text-transform:uppercase;
      color:rgba(224,194,122,.92);
    }

    .afl-score-rank{ font-size:17px; }
    .afl-score-pts{ font-size:12px; }
    .afl-rank-delta{ font-size:9px; min-width:9px; }
    .afl-rank-wrap{ gap:4px; }
  }
</style>

<div class="afl-welcome-wrap">
  <div class="afl-welcome-panel">

    <div class="afl-welcome-logo">
      <div class="afl-logo-wrap">
        <module name="MY_LOGO"/>
      </div>
    </div>

    <div class="afl-welcome-text">
      <div class="afl-welcome-title">
        Welcome, <span style="color:#E0C27A;">%FRANCHISENAME%</span>
      </div>

      <div class="afl-welcome-tagline">
        HIGH STAKES. ONE BULLET. PLAY IT ONCE.
      </div>

      <div class="afl-welcome-sub">
        Armchair 2026 is underway.
      </div>
    </div>

    <!-- Tight scorecard (click -> Live Scoring) -->
    <a class="afl-scorecard"
       href="https://www46.myfantasyleague.com/2025/ajax_ls?L=41802"
       title="Open Live Scoring"
       aria-label="Open Live Scoring">

      <div class="afl-score-row">
        <div class="afl-score-kicker rank-kicker">RANK</div>
        <div class="afl-rank-wrap">
          <div class="afl-score-rank"><span id="liveRank">--</span></div>
          <div id="rankDelta" class="afl-rank-delta afl-rank-flat" title="Rank movement">•</div>
        </div>
      </div>

      <div class="afl-score-divider"></div>

      <div class="afl-score-row">
        <div class="afl-score-kicker">LIVE</div>
        <div class="afl-score-pts"><span id="livePts">--</span></div>
      </div>
    </a>

  </div>
</div>

<script>
(function () {
  // ===== CONFIG =====
  var YEAR = "2025";
  var LEAGUE_ID = "41802";
  var FRANCHISE_ID = "%FRANCHISEID%"; // e.g. 0001
  var HOST = "www46.myfantasyleague.com";

  var LS_URL = "https://" + HOST + "/" + YEAR + "/ajax_ls?L=" + encodeURIComponent(LEAGUE_ID);
  var STORE_KEY = "AFL_LS_RANK_" + YEAR + "_" + LEAGUE_ID + "_" + FRANCHISE_ID;

  var iframe, lastPts = null, lastRankTxt = null;

  function $(id){ return document.getElementById(id); }

  function setText(id, text) {
    var el = $(id);
    if (!el) return;
    el.textContent = (text && (""+text).trim()) ? (""+text).trim() : "--";
  }

  function setDelta(state, symbol, title) {
    var el = $("rankDelta");
    if (!el) return;
    el.className = "afl-rank-delta " + (state || "afl-rank-flat");
    el.textContent = symbol || "•";
    el.title = title || "Rank movement";
  }

  function parseNumber(text) {
    var n = parseFloat(String(text || "").replace(/[^\d.\-]/g, ""));
    return isNaN(n) ? null : n;
  }

  function computeRankFromWeeklyStandings(doc) {
    var nodes = doc.querySelectorAll('div[class^="ogffpts_"]');
    if (!nodes || !nodes.length) return null;

    var entries = [];
    for (var i = 0; i < nodes.length; i++) {
      var node = nodes[i];
      var cls = node.className || "";
      var m = cls.match(/ogffpts_(\d{4})/);
      if (!m) continue;

      var fid = m[1];
      var pts = parseNumber(node.textContent);
      if (pts === null) continue;

      entries.push({ fid: fid, pts: pts });
    }

    if (!entries.length) return null;

    entries.sort(function(a,b){
      if (b.pts !== a.pts) return b.pts - a.pts;
      return a.fid.localeCompare(b.fid);
    });

    for (var r = 0; r < entries.length; r++) {
      if (entries[r].fid === FRANCHISE_ID) return (r + 1);
    }
    return null;
  }

  function updateRankUI(rankNum) {
    if (rankNum === null) {
      setText("liveRank", "--");
      setDelta("afl-rank-flat", "•", "Rank movement");
      return;
    }

    var rankTxt = "#" + rankNum;
    if (rankTxt !== lastRankTxt) {
      lastRankTxt = rankTxt;
      setText("liveRank", rankTxt);
    }

    // Compare to last saved rank (lower is BETTER)
    var prev = null;
    try { prev = parseInt(localStorage.getItem(STORE_KEY), 10); } catch (e) {}
    if (!isFinite(prev)) prev = null;

    if (prev === null) {
      setDelta("afl-rank-flat", "•", "No prior rank to compare yet");
    } else if (rankNum < prev) {
      setDelta("afl-rank-up", "▲", "Moved up (better rank): " + prev + " → " + rankNum);
    } else if (rankNum > prev) {
      setDelta("afl-rank-down", "▼", "Moved down (worse rank): " + prev + " → " + rankNum);
    } else {
      setDelta("afl-rank-flat", "—", "No change in rank");
    }

    try { localStorage.setItem(STORE_KEY, String(rankNum)); } catch (e) {}
  }

  function safeRead() {
    try {
      var doc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
      if (!doc) return;

      var scoreEl = doc.querySelector(".ogffpts_" + FRANCHISE_ID);
      if (scoreEl) {
        var ptsTxt = (scoreEl.textContent || "").trim();
        if (ptsTxt && ptsTxt !== lastPts) {
          lastPts = ptsTxt;
          setText("livePts", ptsTxt);
        }
      }

      var rankNum = computeRankFromWeeklyStandings(doc);
      updateRankUI(rankNum);

    } catch (e) {}
  }

  function buildIframe() {
    iframe = document.createElement("iframe");
    iframe.src = LS_URL;

    iframe.style.position = "absolute";
    iframe.style.left = "-9999px";
    iframe.style.top = "-9999px";
    iframe.style.width = "1px";
    iframe.style.height = "1px";
    iframe.style.border = "0";
    iframe.setAttribute("aria-hidden", "true");

    iframe.addEventListener("load", function () {
      safeRead();
      setInterval(safeRead, 3000);
      setInterval(function () {
        try { iframe.contentWindow.location.reload(); } catch (e) {}
      }, 45000);
    });

    document.body.appendChild(iframe);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", buildIframe);
  } else {
    buildIframe();
  }
})();
</script>
