      // League tabs
      candidates = candidates.concat([].slice.call(document.querySelectorAll("#league_tabs, .leagueTabs, .league-tabs, .league_tab, .leagueTabsContainer")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll("[id*='league'][id*='tab'], [class*='league'][class*='tab']")));
