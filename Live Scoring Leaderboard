      candidates = candidates.concat([].slice.call(document.querySelectorAll("header, .header, #header")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll(".league-menu, .leagueMenu, #league_menu, #leagueMenu")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll("[id*='league'][id*='menu'], [class*='league'][class*='menu']")));
      // Armchair/League title elements
      candidates = candidates.concat([].slice.call(document.querySelectorAll("[id*='armchair'], [class*='armchair']")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll("h1, h2, h3, .title, .page-title, .site-title, .league-title, [class*='title']")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll("nav, .nav, .navbar, .navigation, [class*='nav']")));
      // User account bar and top elements
      candidates = candidates.concat([].slice.call(document.querySelectorAll("[id*='user'], [class*='user'], [id*='account'], [class*='account']")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll(".topbar, .top-bar, #topbar, #top-bar, .masthead, #masthead")));
      candidates = candidates.concat([].slice.call(document.querySelectorAll("footer, .footer, #footer")));
      // Catch any fixed/sticky positioned elements at the top
      candidates = candidates.concat([].slice.call(document.querySelectorAll("[style*='position: fixed'], [style*='position:fixed'], [style*='position: sticky'], [style*='position:sticky']")));

      if(hide){
        hiddenLeagueNodes = [];
        var seen = {};
        candidates.forEach(function(el){
          if(!el || !el.style) return;
          // Skip our own drawer
          if(el.id === "kkDrawer" || el.closest && el.closest("#kkDrawer")) return;
          if(el.id === "kkLiveRoot" || el.closest && el.closest("#kkLiveRoot")) return;

          var key = el.tagName + "|" + (el.id||"") + "|" + (el.className||"");
          if(seen[key]) return;
          seen[key] = true;

          hiddenLeagueNodes.push({
            el: el,
            prevDisplay: el.style.display,
            prevVisibility: el.style.visibility,
            prevZIndex: el.style.zIndex
          });

          el.style.setProperty("display", "none", "important");
          el.style.setProperty("visibility", "hidden", "important");
          el.style.setProperty("z-index", "-1", "important");
        });
      } else {
        hiddenLeagueNodes.forEach(function(x){
          if(x && x.el && x.el.style){
            x.el.style.display = x.prevDisplay || "";
            x.el.style.visibility = x.prevVisibility || "";
            x.el.style.zIndex = x.prevZIndex || "";
          }
        });
        hiddenLeagueNodes = [];
      }
    } catch(e){}
  }

  function lockBodyScroll(lock){
    try{
      if(lock){
        // Prevent body scrolling
        bodyOverflowPrev = document.body.style.overflow || "";
        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.width = "100%";
      } else {
        // Restore body scrolling
        document.body.style.overflow = bodyOverflowPrev;
        document.body.style.position = "";
        document.body.style.width = "";
      }
    } catch(e){}
  }

  function showDrawer(on){
    if(!elDrawer) return;
    if(on){
      hidePageHeaders(true);
      lockBodyScroll(true);
      elDrawer.style.display = "block";

      elDrawerTitle.textContent = (state.viewMode === "TOTAL") ? "VIP Ledger — TOTAL" : "VIP Ledger — LIVE";
      renderDetailInto(elDrawerDetail);
    } else {
      elDrawer.style.display = "none";
      hidePageHeaders(false);
      lockBodyScroll(false);
    }
  }

  if(elCloseBtn) elCloseBtn.onclick = function(){ showDrawer(false); };
  if(elDrawer){
    elDrawer.addEventListener("click", function(e){
      if(e.target === elDrawer) showDrawer(false);
    });
  }

  /* =========================
     VIEW toggle
     ========================= */
  function setViewMode(mode){
    state.viewMode = (mode === "TOTAL") ? "TOTAL" : "LIVE";
    if(elViewToggle){
      elViewToggle.setAttribute("data-value", (state.viewMode === "TOTAL") ? "1" : "0");
    }
    elDrawerTitle.textContent = (state.viewMode === "TOTAL") ? "VIP Ledger — TOTAL" : "VIP Ledger — LIVE";

    if(state.viewMode === "TOTAL"){
      elStatusPill.textContent = "Totals…";
      loadTotals(true).then(render).catch(render);
    } else {
      elStatusPill.textContent = state.liveWeek ? ("Live W" + state.liveWeek) : "Live…";
      // Ensure totals are available for interim ranking
      loadTotals(false).catch(function(){});
      render();
    }
  }

  if(elViewToggle){
    var vBtns = elViewToggle.querySelectorAll(".kkToggleBtn");
    for(var vb=0; vb<vBtns.length; vb++){
      vBtns[vb].onclick = function(){
        var idx = this.getAttribute("data-idx");
        setViewMode(idx === "1" ? "TOTAL" : "LIVE");
      };
    }
  }

  /* =========================
     MAIN render
     ========================= */
  function render(){
    var rows = buildLeaderboardRows();

    if(state.selectedFranchiseId && !rows.some(function(r){ return r.id === state.selectedFranchiseId; })){
      state.selectedFranchiseId = rows.length ? rows[0].id : null;
    }

    renderLeaderboard(rows);

    if(elDetail) renderDetailInto(elDetail);

    if(isMobile() && elDrawer && elDrawer.style.display === "block"){
      renderDetailInto(elDrawerDetail);
    }
  }

  /* =========================
     BOOT
     ========================= */
  function boot(){
    elStatusPill.textContent = "Loading…";
    elDetail.innerHTML = '<div style="padding:14px;border:1px dashed rgba(212,175,55,.22);border-radius:14px;background:rgba(0,0,0,.16);color:rgba(242,238,230,.65);">Loading league data…</div>';

    setViewMode("LIVE");

    loadLeague().then(function(){
      render();

      // Load players and totals in background (totals also needed for interim ranking)
      loadPlayers().catch(function(){});
      loadTotals(true).catch(function(){});

      // First live poll
      pollLive().then(function(){
        render();

        setInterval(function(){
          pollLive().then(function(){
            if(state.viewMode === "TOTAL"){
              loadTotals(false).then(render).catch(render);
            } else {
              // refresh totals occasionally so interim ranking stays true
              loadTotals(false).catch(function(){});
              render();
            }
          }).catch(function(){
            // status pill set in pollLive catch
          });
        }, POLL_MS);

      }).catch(function(){
        elStatusPill.textContent = "Error";
        elDetail.innerHTML = '<div style="padding:14px;border:1px dashed rgba(212,175,55,.22);border-radius:14px;background:rgba(0,0,0,.16);color:rgba(242,238,230,.65);">Couldn’t load live scoring. Check host/year/league/APIKEY.</div>';
      });

    }).catch(function(){
      elStatusPill.textContent = "Error";
      elDetail.innerHTML = '<div style="padding:14px;border:1px dashed rgba(212,175,55,.22);border-radius:14px;background:rgba(0,0,0,.16);color:rgba(242,238,230,.65);">Couldn’t load league/franchises. Check host/year/league/APIKEY.</div>';
    });

    window.addEventListener("resize", function(){
      if(!isMobile()) showDrawer(false);
    });
  }

  boot();
})();
</script>
