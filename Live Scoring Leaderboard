<!-- KING KRING | VIP LIVE LEADERBOARD + TOTALS + HEAD-TO-HEAD (MFL-SAFE, SINGLE FILE) -->
<style>
  :root{
    --bg0:#060504;
    --bg1:#0c0a07;
    --card:#120f0b;
    --card2:#15120d;
    --line:rgba(212,175,55,.18);
    --gold:#d4af37;
    --text:#f2eee6;
    --muted:rgba(242,238,230,.68);
    --shadow: 0 20px 70px rgba(0,0,0,.55);
    --radius: 18px;
    --ox:#5A0F14;

    --pos:#3fb950;
    --neg:#f85149;
    --zero:rgba(242,238,230,.45);
  }
  *{box-sizing:border-box}

  .kkLive{
    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial;
    color:var(--text);
    background:
      radial-gradient(1200px 900px at 20% -10%, rgba(212,175,55,.12), transparent 60%),
      radial-gradient(900px 700px at 120% 20%, rgba(212,175,55,.08), transparent 50%),
      linear-gradient(180deg, var(--bg0), var(--bg1));
    border-radius: 20px;
    border: 1px solid rgba(212,175,55,.16);
    box-shadow: var(--shadow);
    overflow:hidden;
  }
  .kkWrap{ max-width: 1200px; margin: 0 auto; padding: 12px; }
  .kkShell{ display:grid; grid-template-columns: 1.05fr .95fr; gap: 14px; }

  .kkPanel{
    background: linear-gradient(180deg, rgba(255,255,255,.04), transparent 45%),
                linear-gradient(180deg, var(--card), var(--card2));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow:hidden;
    position:relative;
  }
  .kkPanel:before{
    content:"";
    position:absolute; inset:0;
    pointer-events:none;
    background: radial-gradient(800px 240px at 30% 0%, rgba(212,175,55,.10), transparent 60%);
    opacity:.9;
  }

  .kkHdr{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 12px 12px 10px 12px;
    border-bottom: 1px solid rgba(212,175,55,.12);
    gap:10px;
  }
  .kkHdrLeft{
    display:flex;
    align-items:center;
    gap:10px;
    min-width:0;
    flex: 1 1 auto;
    flex-wrap:wrap;
  }
  .kkHdrRight{
    display:flex;
    align-items:center;
    gap:10px;
    flex:0 0 auto;
  }
  .kkPill{
    border: 1px solid rgba(212,175,55,.22);
    background: rgba(0,0,0,.25);
    padding: 6px 10px;
    border-radius: 999px;
    white-space:nowrap;
    font-size: 12px;
    color: var(--muted);
  }

  /* ===== TOGGLE (LEFT PANE) ===== */
  .kkToggle{
    position:relative;
    border:1px solid rgba(212,175,55,.20);
    background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(0,0,0,.22));
    border-radius: 999px;
    padding: 4px;
    height: 40px;
    width: 180px;
    overflow:hidden;
    -webkit-tap-highlight-color: transparent;
    flex: 0 0 auto;
  }
  .kkToggle::before{
    content:"";
    position:absolute;
    top:4px; bottom:4px;
    left:4px;
    width: calc(50% - 2px);
    border-radius: 999px;
    background: rgba(90,15,20,.92);
    box-shadow: 0 10px 24px rgba(0,0,0,.35);
    transform: translateX(0%);
    transition: transform .18s ease, background .18s ease;
  }
  .kkToggle[data-value="1"]::before{
    transform: translateX(100%);
    background: rgba(242,238,230,.92);
  }
  .kkToggleRow{
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns: 1fr 1fr;
    height:100%;
  }
  .kkToggleBtn{
    border:0 !important;
    background: transparent !important;
    cursor:pointer;
    font-weight: 900;
    letter-spacing:.12em;
    text-transform:uppercase;
    font-size: 10px;
    padding: 0;
    border-radius: 999px;
    color: rgba(242,238,230,.70);
    user-select:none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .kkToggle[data-value="0"] .kkToggleBtn[data-idx="0"]{ color: rgba(242,238,230,.95); }
  .kkToggle[data-value="0"] .kkToggleBtn[data-idx="1"]{ color: rgba(242,238,230,.62); }
  .kkToggle[data-value="1"] .kkToggleBtn[data-idx="0"]{ color: rgba(242,238,230,.70); }
  .kkToggle[data-value="1"] .kkToggleBtn[data-idx="1"]{ color: #2b2420; }

  /* ===== LEFT LIST ===== */
  .kkList{
    position:relative;
    padding: 10px;
    max-height: 78vh;
    overflow:auto;
  }

  .kkRow{
    display:grid;
    grid-template-columns: 50px 1fr 96px;
    gap: 10px;
    align-items:center;
    padding: 10px 10px;
    border-radius: 14px;
    border: 1px solid transparent;
    cursor:pointer;
    user-select:none;
    transition: transform .12s ease, background .12s ease, border-color .12s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .kkRow:hover{
    transform: translateY(-1px);
    background: rgba(212,175,55,.06);
    border-color: rgba(212,175,55,.18);
  }
  .kkRow.kkActive{
    background: rgba(212,175,55,.10);
    border-color: rgba(212,175,55,.28);
    box-shadow: 0 0 0 1px rgba(212,175,55,.10) inset;
  }
  .kkRow.kkTop{
    background: rgba(212,175,55,.06);
    border-color: rgba(212,175,55,.22);
    box-shadow:
      0 10px 26px rgba(0,0,0,.30),
      inset 0 0 0 1px rgba(212,175,55,.10);
  }
  .kkRow.kkGold{
    background: linear-gradient(180deg, rgba(255,215,0,.12), rgba(212,175,55,.08));
    border-color: rgba(255,215,0,.38);
    box-shadow:
      0 10px 28px rgba(0,0,0,.32),
      inset 0 0 0 1px rgba(255,215,0,.18);
  }
  .kkRow.kkSilver{
    background: linear-gradient(180deg, rgba(192,192,192,.10), rgba(169,169,169,.06));
    border-color: rgba(192,192,192,.32);
    box-shadow:
      0 10px 26px rgba(0,0,0,.30),
      inset 0 0 0 1px rgba(192,192,192,.14);
  }
  .kkRow.kkBronze{
    background: linear-gradient(180deg, rgba(205,127,50,.10), rgba(184,115,51,.06));
    border-color: rgba(205,127,50,.32);
    box-shadow:
      0 10px 26px rgba(0,0,0,.30),
      inset 0 0 0 1px rgba(205,127,50,.14);
  }
  .kkRow.kkMe{
    background: linear-gradient(180deg, rgba(90,15,20,.34), rgba(0,0,0,.18));
    border-color: rgba(90,15,20,.55);
    box-shadow:
      0 12px 26px rgba(0,0,0,.32),
      inset 0 0 0 1px rgba(90,15,20,.30);
  }
  .kkRow.kkMe:hover{ border-color: rgba(90,15,20,.70); }

  .kkRankTile{
    width: 46px; height: 46px;
    border-radius: 10px;
    border: 1px solid rgba(212,175,55,.22);
    background: rgba(0,0,0,.22);
    position:relative;
    overflow:hidden;
    display:grid;
    place-items:center;
  }
  .kkRankTile .kkWM{
    position:absolute; inset:0;
    background-position:center;
    background-size: cover;
    opacity:.18;
    filter: saturate(.7) contrast(1.05);
    transform: scale(1.05);
  }
  .kkRankTile .kkRankNum{
    position:relative;
    font-weight: 950;
    font-size: 16px;
    letter-spacing:.2px;
    color: rgba(242,238,230,.95);
    text-shadow: 0 1px 0 rgba(0,0,0,.65);
  }

  .kkText{ min-width:0; }
  .kkFrName{
    font-weight: 850;
    letter-spacing:.01em;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    line-height:1.1;
  }
  .kkOwner{
    margin-top:4px;
    font-size: 12px;
    color: var(--muted);
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    line-height:1.12;
  }

  .kkScoreCluster{
    text-align:right;
    min-width:0;
  }
  .kkPts{
    font-variant-numeric: tabular-nums;
    font-size: 16px;
    font-weight: 950;
    color: rgba(242,238,230,.96);
    white-space:nowrap;
    line-height:1;
  }
  .kkMiniMeta{
    margin-top:4px;
    font-size:11px;
    color: rgba(242,238,230,.62);
    line-height:1.1;
    white-space:nowrap;
  }
  .kkMiniMeta b{ color: rgba(242,238,230,.90); font-weight:800; }

  /* ===== RIGHT DETAIL ===== */
  .kkDetail{
    position:relative;
    padding: 12px;
    max-height: 78vh;
    overflow:auto;
    -webkit-overflow-scrolling: touch;
  }

  .kkHero{
    display:flex;
    gap: 12px;
    align-items:center;
    padding: 12px;
    border-radius: 16px;
    border: 1px solid rgba(212,175,55,.18);
    background: rgba(0,0,0,.20);
  }
  .kkLogo{
    width: 54px; height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(212,175,55,.20);
    background: rgba(0,0,0,.26);
    display:grid; place-items:center;
    overflow:hidden;
    flex: 0 0 auto;
    text-decoration:none;
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
    cursor:pointer;
  }
  .kkLogo:hover{
    border-color: rgba(212,175,55,.45);
    transform: scale(1.05);
    box-shadow: 0 0 0 2px rgba(212,175,55,.15);
  }
  .kkLogo img{ width:100%; height:100%; object-fit:cover; display:block; }

  .kkHeroMain{ min-width:0; }
  .kkHeroName{
    margin:0;
    font-size: 16px;
    font-weight: 950;
    letter-spacing:.02em;
    color: rgba(212,175,55,.92);
    text-shadow: 0 1px 0 rgba(0,0,0,.65);
    background: transparent !important;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    line-height:1.1;
  }
  .kkHeroOwner{
    margin-top:4px;
    font-size: 12px;
    color: rgba(242,238,230,.72);
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    line-height:1.12;
  }

  .kkHeroScore{
    margin-left:auto;
    text-align:right;
    flex:0 0 auto;
  }
  .kkHeroScore .kkBig{
    font-size: 26px;
    font-weight: 950;
    font-variant-numeric: tabular-nums;
    line-height:1;
  }
  .kkHeroScore .kkSmall{
    font-size: 11px;
    color: var(--muted);
    margin-top:3px;
  }

  .kkMini{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 10px;
    align-items:stretch;
  }
  .kkBox{
    border: 1px solid rgba(212,175,55,.14);
    background: rgba(0,0,0,.16);
    border-radius: 14px;
    padding: 8px 10px;
    overflow:hidden;
  }
  .kkK{ font-size: 11px; color: var(--muted); letter-spacing:.02em; }
  .kkV{ font-size: 15px; font-weight: 950; margin-top: 2px; }

  /* ===== PRIMARY BUTTON ===== */
  .kkBtn{
    display:flex;
    align-items:center;
    justify-content:center;
    width:100%;
    border:1px solid rgba(212,175,55,.22);
    background: linear-gradient(180deg, rgba(90,15,20,.92), rgba(50,10,12,.78));
    color: rgba(242,238,230,.95);
    font-weight: 950;
    letter-spacing:.10em;
    text-transform:uppercase;
    font-size: 11px;
    border-radius: 12px;
    padding: 12px 10px; /* tap-safe */
    cursor:pointer;
    user-select:none;
    box-shadow: 0 14px 30px rgba(0,0,0,.35);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform .15s ease, filter .15s ease, border-color .15s ease, opacity .15s ease, box-shadow .15s ease;
  }
  .kkBtn:hover{
    filter: brightness(1.08);
    border-color: rgba(212,175,55,.50);
    transform: scale(1.02);
    box-shadow: 0 0 0 3px rgba(212,175,55,.18), 0 16px 35px rgba(0,0,0,.4);
  }
  .kkBtn:active{
    transform: scale(0.98) translateY(1px);
    box-shadow: 0 0 0 2px rgba(212,175,55,.25), 0 8px 20px rgba(0,0,0,.3);
  }
  .kkBtn[disabled]{ opacity:.45; cursor:not-allowed; }

  /* ===== LIVE TABLE ===== */
  .kkTable{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    margin-top: 10px;
    overflow:hidden;
    border-radius: 14px;
    border: 1px solid rgba(212,175,55,.14);
  }
  .kkThead th{
    text-align:left;
    font-size: 11px;
    color: rgba(242,238,230,.60);
    letter-spacing:.10em;
    text-transform:uppercase;
    padding: 9px 10px;
    background: rgba(0,0,0,.18);
    border-bottom: 1px solid rgba(212,175,55,.10);
    white-space:nowrap;
  }
  .kkThead th.num{ text-align:right; }

  .kkTable tr{ background: rgba(0,0,0,.14); }
  .kkTable tr + tr td{ border-top: 1px solid rgba(212,175,55,.08); }
  .kkTable td{
    padding: 8px 10px;
    font-size: 13px;
    color: rgba(242,238,230,.88);
    vertical-align:middle;
  }
  .kkSlot{
    width: 84px;
    color: rgba(242,238,230,.70);
    font-size: 11px;
    letter-spacing:.06em;
    text-transform:uppercase;
    white-space:nowrap;
  }
  .kkSlotLine{
    display:flex;
    align-items:center;
    gap:6px;
    white-space:nowrap;
  }
  .kkDot{
    width:7px; height:7px; border-radius:999px;
    background: transparent;
    border:1px solid rgba(242,238,230,.18);
    flex:0 0 auto;
  }
  .kkDot.on{
    background: rgba(63,185,80,.92);
    border-color: rgba(63,185,80,.92);
    box-shadow: 0 0 0 3px rgba(63,185,80,.10);
  }

  .kkPlayer{
    min-width:0;
    font-weight: 800;
    letter-spacing:.01em;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .kkNum{
    text-align:right;
    font-variant-numeric: tabular-nums;
    white-space:nowrap;
  }
  .kkNum.them{ font-weight: 950; color: rgba(242,238,230,.92); }

  /* ===== MOBILE roster ===== */
  .kkMobileList{ display:none; margin-top:10px; }
  .kkMRow{
    border: 1px solid rgba(212,175,55,.14);
    background: rgba(0,0,0,.14);
    border-radius: 12px;
    padding: 9px 10px;
  }
  .kkMRow + .kkMRow{ margin-top: 8px; }

  .kkMGrid{
    display:grid;
    grid-template-columns: minmax(0, 1fr) 84px;
    gap: 8px;
    align-items:center;
    line-height:1.15;
  }
  .kkMLeft{
    min-width:0;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .kkMSlot{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    gap:6px;
    font-size:11px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color: rgba(242,238,230,.70);
    white-space:nowrap;
  }
  .kkMName{
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    font-weight: 650;
    color: rgba(242,238,230,.90);
  }
  .kkMNum{
    text-align:right;
    font-variant-numeric: tabular-nums;
    white-space:nowrap;
    font-size:12px;
    font-weight:900;
    color: rgba(242,238,230,.92);
  }

  /* ===== DRAWER (MOBILE VIP LEDGER) ===== */
  .kkDrawer{
    display:none;
    position:fixed !important;
    left:0 !important;
    right:0 !important;
    bottom:0 !important;
    top:0 !important;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(6px);
    z-index: 999998 !important;
    padding: 12px;
    touch-action: none;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .kkDrawerCard{
    max-width: 980px;
    margin: 0 auto;
    border-radius: 18px;
    border: 1px solid rgba(212,175,55,.18);
    background:
      radial-gradient(900px 240px at 20% 10%, rgba(255,255,255,.05), transparent 60%),
      linear-gradient(180deg, rgba(22,18,16,.92) 0%, rgba(8,8,10,.90) 100%);
    box-shadow: 0 24px 70px rgba(0,0,0,.70);
    overflow:hidden;
    position:relative;
    max-height: calc(100vh - 24px);
    overflow-y: auto;
  }
  .kkDrawerHdr{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 12px 12px 10px 12px;
    border-bottom: 1px solid rgba(212,175,55,.10);
  }
  .kkDrawerTitle{
    letter-spacing:.10em;
    text-transform:uppercase;
    font-size: 12px;
    font-weight: 900;
    color: rgba(212,175,55,.92);
  }
  .kkClose{
    border:1px solid rgba(212,175,55,.18);
    background: rgba(90,15,20,.55);
    color: rgba(242,238,230,.92);
    font-weight: 900;
    width: 44px; height: 44px;
    border-radius: 14px;
    cursor:pointer;
    touch-action: manipulation;
    flex-shrink: 0;
    transition: background .2s ease, transform .2s ease;
  }
  .kkClose:hover{
    background: rgba(90,15,20,.75);
    transform: scale(1.05);
  }
  .kkClose:active{
    transform: scale(0.95);
  }

  /* ===== H2H MODAL ===== */
  .kkH2HModal{
    display:none;
    position:fixed !important;
    left:0 !important;
    right:0 !important;
    bottom:0 !important;
    top:0 !important;
    background: rgba(0,0,0,.58);
    backdrop-filter: blur(6px);
    z-index: 2147483647 !important;
    padding: 12px;
    touch-action: none;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .kkH2HCard{
    max-width: 980px;
    margin: 0 auto;
    border-radius: 18px;
    border: 1px solid rgba(212,175,55,.18);
    background:
      radial-gradient(900px 240px at 20% 10%, rgba(255,255,255,.05), transparent 60%),
      linear-gradient(180deg, rgba(22,18,16,.92) 0%, rgba(8,8,10,.90) 100%);
    box-shadow: 0 24px 80px rgba(0,0,0,.74);
    overflow:hidden;
    position:relative;
    z-index: 2147483647 !important;
    max-height: calc(100vh - 24px);
    overflow-y: auto;
  }
  .kkH2HHdr{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 12px 12px 10px 12px;
    border-bottom: 1px solid rgba(212,175,55,.10);
    gap:10px;
  }
  .kkH2HTitle{
    letter-spacing:.10em;
    text-transform:uppercase;
    font-size: 12px;
    font-weight: 900;
    color: rgba(212,175,55,.92);
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .kkH2HSummary{
    display:grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    padding: 16px 12px 0 12px;
    align-items:center;
  }
  .kkH2HTeam{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
    min-width:0;
  }
  .kkH2HTeam.left{ align-items:flex-end; }
  .kkH2HTeam.right{ align-items:flex-start; }

  .kkH2HMiniLogo{
    width: 64px; height: 64px;
    border-radius: 16px;
    border: 1px solid rgba(212,175,55,.22);
    background: rgba(0,0,0,.26);
    display:grid;
    place-items:center;
    overflow:hidden;
    flex: 0 0 auto;
    box-shadow: 0 4px 16px rgba(0,0,0,.3);
  }
  .kkH2HMiniLogo img{ width:100%; height:100%; object-fit:cover; display:block; }
  .kkH2HName{
    font-weight: 950;
    font-size: 15px;
    color: rgba(242,238,230,.92);
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    line-height:1.2;
    max-width:100%;
  }
  .kkH2HSub{
    margin-top:2px;
    font-size: 11px;
    color: rgba(242,238,230,.58);
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    line-height:1.1;
    max-width:100%;
  }

  .kkH2HVersus{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
    padding:0 12px;
    flex:0 0 auto;
  }
  .kkH2HScoreLine{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .kkH2HScore{
    font-variant-numeric: tabular-nums;
    font-weight: 950;
    font-size: 28px;
    color: rgba(242,238,230,.95);
    white-space:nowrap;
    line-height:1;
  }
  .kkH2HVsLabel{
    font-size: 11px;
    letter-spacing:.12em;
    text-transform:uppercase;
    color: rgba(212,175,55,.75);
    font-weight: 900;
  }

  /* ===== COMPACT H2H GRID ===== */
  .kkH2HGrid{ padding: 0 12px 12px 12px; }

  .kkH2HCompact{
    border: 1px solid rgba(212,175,55,.14);
    border-radius: 14px;
    overflow:hidden;
    margin-top: 10px;
  }
  .kkH2HCompactHdr{
    display:grid;
    grid-template-columns: 1fr 70px 70px 70px 1fr;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(0,0,0,.18);
    border-bottom: 1px solid rgba(212,175,55,.10);
    font-size: 10px;
    letter-spacing:.10em;
    text-transform:uppercase;
    color: rgba(242,238,230,.60);
    font-weight: 800;
  }
  .kkH2HCompactHdr .cMid{ text-align:center; }
  .kkH2HCompactHdr .cR{ text-align:right; }

  .kkH2HCompactRow{
    display:grid;
    grid-template-columns: 1fr 70px 70px 70px 1fr;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(0,0,0,.14);
    align-items:center;
  }
