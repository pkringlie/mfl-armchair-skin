<script>
(function(){
  var HOST = "%HOST%";
  var YEAR = "%YEAR%";
  var LEAGUE_ID = "%LEAGUEID%";
  var VIEWER_FRANCHISE_ID = "%FRANCHISEID%";

  // Keep if your weeklyResults needs it inside the embed.
  var APIKEY = "bhJu2MCQvuWqx0CmPFjJYTAeFbox";

  var POLL_MS = 20000;

  var elLeaderboard   = document.getElementById("kkLeaderboard");
  var elDetail        = document.getElementById("kkDetail");
  var elLastUpdated   = document.getElementById("kkLastUpdated");
  var elStatusPill    = document.getElementById("kkStatusPill");
  var elViewToggle    = document.getElementById("kkViewToggle");

  var elDrawer        = document.getElementById("kkDrawer");
  var elDrawerDetail  = document.getElementById("kkDrawerDetail");
  var elCloseBtn      = document.getElementById("kkCloseBtn");
  var elDrawerTitle   = document.getElementById("kkDrawerTitle");

  var elH2HModal      = document.getElementById("kkH2HModal");
  var elH2HBody       = document.getElementById("kkH2HBody");
  var elH2HTitle      = document.getElementById("kkH2HTitle");
  var elH2HCloseBtn   = document.getElementById("kkH2HCloseBtn");

  var state = {
    franchiseById: {},
    franchiseOrderIndex: {},

    playerById: {},

    liveByFranchiseId: {},
    liveWeek: "",

    totalByFranchiseId: {},
    totalPosByFranchiseId: {},
    totalsLastLoadedAt: 0,

    selectedFranchiseId: null,

    lastLiveGoodAt: 0,
    viewMode: "LIVE"
  };

  function isMobile(){
    return window.matchMedia && window.matchMedia("(max-width: 980px)").matches;
  }
  function isPhone(){
    return window.matchMedia && window.matchMedia("(max-width: 520px)").matches;
  }

  function mflUrl(type, params){
    params = params || {};
    var base = "https://" + HOST + "/" + YEAR + "/export";
    var u = new URL(base);
    u.searchParams.set("TYPE", type);
    u.searchParams.set("L", LEAGUE_ID);
    u.searchParams.set("JSON", "0");
    if (APIKEY) u.searchParams.set("APIKEY", APIKEY);
    for (var k in params){
      if (params[k] === undefined || params[k] === null) continue;
      // IMPORTANT: omit parameters entirely when value is special sentinel "__OMIT__"
      if (params[k] === "__OMIT__") continue;
      u.searchParams.set(k, String(params[k]));
    }
    return u.toString();
  }

  function fetchText(url){
    return fetch(url, { cache:"no-store" }).then(function(res){
      if(!res.ok) throw new Error("HTTP " + res.status);
      return res.text();
    });
  }

  function parseXml(xmlText){
    var doc = new DOMParser().parseFromString(xmlText, "text/xml");
    if (doc.querySelector("parsererror")) throw new Error("XML parse error");
    return doc;
  }

  function qa(node, sel){ return node ? Array.prototype.slice.call(node.querySelectorAll(sel)) : []; }
  function attr(node, name, fallback){
    fallback = (fallback === undefined) ? "" : fallback;
    if(!node || !node.getAttribute) return fallback;
    var v = node.getAttribute(name);
    return (v === null || v === undefined) ? fallback : v;
  }
  function toNum(v, fallback){
    fallback = (fallback === undefined) ? 0 : fallback;
    var n = Number(v);
    return isFinite(n) ? n : fallback;
  }
  function fmtPts(n){
    return (Math.round(n * 100) / 100).toFixed(2);
  }
  function escapeHtml(s){
    s = (s===null || s===undefined) ? "" : String(s);
    return s.replace(/[&<>"']/g, function(ch){
      return ({
        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#39;"
      })[ch];
    });
  }

  function safeFrOrderIndex(fid){
    return (state.franchiseOrderIndex && state.franchiseOrderIndex[fid] !== undefined)
      ? state.franchiseOrderIndex[fid]
      : 999999;
  }

  function normalizePos(pos){
    pos = (pos || "").toUpperCase();
    if(pos === "PK") return "K";
    if(pos === "DST" || pos === "DEF" || pos === "D" || pos === "DF") return "DEF";
    return pos;
  }

  function formatPlayerShort(name){
    name = (name || "").trim();
    if(!name) return "—";
    // Handle "Last, First"
    if(name.indexOf(",") >= 0){
      var parts = name.split(",");
      var last = (parts[0] || "").trim();
      var first = (parts[1] || "").trim();
      var fi = first ? first.charAt(0).toUpperCase() : "";
      return (fi ? (fi + ". ") : "") + (last || "—");
    }
    // Handle "First Last"
    var toks = name.split(/\s+/).filter(Boolean);
    if(toks.length === 1) return toks[0];
    var first2 = toks[0];
    var last2 = toks[toks.length - 1];
    return first2.charAt(0).toUpperCase() + ". " + last2;
  }

  function franchiseUrl(franchiseId){
    return "https://" + HOST + "/" + YEAR + "/options?L=" + LEAGUE_ID + "&O=01&F=" + franchiseId;
  }

  /* =========================
     LOAD: LEAGUE (stable franchise order)
     ========================= */
  function loadLeague(){
    return fetchText(mflUrl("league")).then(function(xml){
      var doc = parseXml(xml);
      var franchises = qa(doc, "league > franchises > franchise");
      var byId = {};
      var orderIndex = {};
      for(var i=0;i<franchises.length;i++){
        var fr = franchises[i];
        var id = attr(fr, "id");
        if(!id) continue;
        var owner = attr(fr, "owner_name") || attr(fr, "owner") || attr(fr, "email") || "";
        byId[id] = {
          id: id,
          name: attr(fr, "name") || id,
          icon: attr(fr, "icon") || "",
          owner: owner
        };
        orderIndex[id] = i; // stable
      }
      state.franchiseById = byId;
      state.franchiseOrderIndex = orderIndex;

      if(!state.selectedFranchiseId){
        state.selectedFranchiseId = byId[VIEWER_FRANCHISE_ID] ? VIEWER_FRANCHISE_ID : (Object.keys(byId)[0] || null);
      }
    });
  }

  /* =========================
     LOAD: PLAYERS
     ========================= */
  function loadPlayers(){
    return fetchText(mflUrl("players", { DETAILS:"" })).then(function(xml){
      var doc = parseXml(xml);
      var players = qa(doc, "players > player");
      var byId = {};
      players.forEach(function(p){
        var id = attr(p, "id");
        if(!id) return;
        byId[id] = {
          id: id,
          name: attr(p, "name") || id,
          pos: normalizePos(attr(p, "position") || attr(p, "pos") || ""),
          team: (attr(p, "team") || "").toUpperCase()
        };
      });
      state.playerById = byId;
    });
  }

  /* =========================
     LIVE POLL (NO hard week dependency)
     ========================= */
  function pollLive(){
    // Omit W entirely so MFL can choose current week; we still parse week="20" from response.
    var url = mflUrl("liveScoring", { DETAILS:"1", W:"__OMIT__" });
    return fetchText(url).then(function(xml){
      var doc = parseXml(xml);
      var root = doc && doc.documentElement;
      if(root && (root.tagName || "").toLowerCase() === "livescoring"){
        state.liveWeek = attr(root, "week", state.liveWeek || "");
      }

      var teams = qa(doc, "liveScoring > franchise");
      var liveById = {};

      teams.forEach(function(t){
        var id = attr(t, "id");
        if(!id) return;

        var starters = qa(t, "players > player").filter(function(p){
          return attr(p,"status")==="starter";
        }).map(function(p){
          return {
            playerId: attr(p, "id"),
            points: toNum(attr(p, "score","0"), 0),
            status: attr(p, "status",""),
            gameSecondsRemaining: toNum(attr(p, "gameSecondsRemaining","0"), 0)
          };
        });

        liveById[id] = {
          franchiseId: id,
          score: toNum(attr(t, "score","0"), 0),
          playersCurrentlyPlaying: toNum(attr(t, "playersCurrentlyPlaying","0"), 0),
          playersYetToPlay: toNum(attr(t, "playersYetToPlay","0"), 0),
          gameSecondsRemaining: toNum(attr(t, "gameSecondsRemaining","0"), 0),
          starters: starters
        };
      });

      if(Object.keys(liveById).length > 0){
        state.liveByFranchiseId = liveById;
        state.lastLiveGoodAt = Date.now();
        if(state.viewMode === "LIVE"){
          elStatusPill.textContent = state.liveWeek ? ("Live W" + state.liveWeek) : "Live";
        }
      } else {
        if(state.viewMode === "LIVE"){
          elStatusPill.textContent = state.lastLiveGoodAt ? "Stale (last good)" : "No data";
        }
      }
    }).catch(function(){
      if(state.viewMode === "LIVE"){
        elStatusPill.textContent = state.lastLiveGoodAt ? "Stale (network)" : "Offline";
      }
    });
  }

  function isParticipatingLive(fid){
    var live = state.liveByFranchiseId[fid];
    if(!live) return false;
    // This is the key fix for Week 20 pre-kickoff:
    // include teams with "yetToPlay=9" even if score=0 and playing=0.
    return (
      toNum(live.playersYetToPlay,0) > 0 ||
      toNum(live.playersCurrentlyPlaying,0) > 0 ||
      Math.abs(toNum(live.score,0)) > 0.0001 ||
      toNum(live.gameSecondsRemaining,0) > 0
    );
  }

  /* =========================
     TOTALS (weeklyResults W=YTD)
     ========================= */
  function ensurePosBucket(map, fid){
    if(!map[fid]) map[fid] = { QB:0, RB:0, WR:0, TE:0, K:0, DEF:0, OTHER:0 };
    return map[fid];
  }
  function addPosScore(bucket, pos, pts){
    pos = normalizePos(pos || "");
    if(pos === "QB") bucket.QB += pts;
    else if(pos === "RB") bucket.RB += pts;
    else if(pos === "WR") bucket.WR += pts;
    else if(pos === "TE") bucket.TE += pts;
    else if(pos === "K") bucket.K += pts;
    else if(pos === "DEF") bucket.DEF += pts;
    else bucket.OTHER += pts;
  }

  function computeTotalsFromWeeklyResults(doc){
    var totals = {};
    var posTotals = {};

    var weekNodes = qa(doc, "weeklyResults");
    if(!weekNodes.length) weekNodes = qa(doc, "allWeeklyResults > weeklyResults");
    if(!weekNodes.length && doc && doc.documentElement){
      if(((doc.documentElement.tagName||"").toLowerCase()) === "weeklyresults"){
        weekNodes = [doc.documentElement];
      }
    }

    weekNodes.forEach(function(weekEl){
      var frs = qa(weekEl, "franchise");
      frs.forEach(function(fr){
        var fid = attr(fr, "id") || "";
        if(!fid) return;

        var fScore = toNum(attr(fr, "score","0"), 0);
        totals[fid] = (totals[fid] || 0) + fScore;

        var bucket = ensurePosBucket(posTotals, fid);
        var pnodes = qa(fr, "player");
        for(var i=0;i<pnodes.length;i++){
          var p = pnodes[i];
          var pid = attr(p,"id");
          var pts = toNum(attr(p,"score","0"), 0);

          var meta = pid ? state.playerById[pid] : null;
          var pos = meta && meta.pos ? meta.pos : (attr(p,"position") || attr(p,"pos") || "");
          addPosScore(bucket, pos, pts);
        }
      });
    });

    return { totals: totals, posTotals: posTotals, weeksFound: weekNodes.length };
  }

  function loadTotals(force){
    if(!force && state.totalsLastLoadedAt && (Date.now() - state.totalsLastLoadedAt) < 60000){
      return Promise.resolve();
    }

    return fetchText(mflUrl("weeklyResults", { W:"YTD", MISSING_AS_BYE:"" }))
      .then(function(xml){
        var doc = parseXml(xml);
        var computed = computeTotalsFromWeeklyResults(doc);
        state.totalByFranchiseId = computed.totals || {};
        state.totalPosByFranchiseId = computed.posTotals || {};
        state.totalsLastLoadedAt = Date.now();
        if(state.viewMode === "TOTAL") elStatusPill.textContent = "Totals";
      })
      .catch(function(){
        if(state.viewMode === "TOTAL"){
          elStatusPill.textContent = state.totalsLastLoadedAt ? "Totals (stale)" : "Totals error";
        }
      });
  }

  /* =========================
     LEADERBOARD BUILD + SORT
     ========================= */
  function buildLeaderboardRows(){
    var ids = Object.keys(state.franchiseById);
    var rows = ids.map(function(id){
      var fr = state.franchiseById[id];
      var live = state.liveByFranchiseId[id] || null;

      if(state.viewMode === "TOTAL"){
        var tscore = toNum((state.totalByFranchiseId && state.totalByFranchiseId[id]) || 0, 0);
        return {
          id: id,
          name: fr ? fr.name : id,
          icon: fr ? fr.icon : "",
          owner: fr ? (fr.owner || "") : "",
          score: tscore,
          playing: 0,
          yet: 0,
          total: tscore
        };
      }

      var liveScore = live ? toNum(live.score,0) : 0;
      var yet = live ? toNum(live.playersYetToPlay,0) : 0;
      var playing = live ? toNum(live.playersCurrentlyPlaying,0) : 0;

      var totalFallback = toNum((state.totalByFranchiseId && state.totalByFranchiseId[id]) || 0, 0);

      return {
        id: id,
        name: fr ? fr.name : id,
        icon: fr ? fr.icon : "",
        owner: fr ? (fr.owner || "") : "",
        score: liveScore,
        playing: playing,
        yet: yet,
        total: totalFallback
      };
    });

    if(state.viewMode === "LIVE"){
      rows = rows.filter(function(r){ return isParticipatingLive(r.id); });
    }

    // Decide LIVE sorting mode:
    // - If anyone has points OR currently playing > 0 => "true live"
    // - Else pre-kickoff all 0.00 => "interim rank by TOTAL"
    var hasTrueLive = false;
    if(state.viewMode === "LIVE"){
      for(var i=0;i<rows.length;i++){
        if(Math.abs(toNum(rows[i].score,0)) > 0.0001 || toNum(rows[i].playing,0) > 0){
          hasTrueLive = true; break;
        }
      }
    }

    if(state.viewMode === "TOTAL"){
      rows.sort(function(a,b){
        var d = (toNum(b.score,0) - toNum(a.score,0));
        if(d) return d;
        var od = safeFrOrderIndex(a.id) - safeFrOrderIndex(b.id);
        if(od) return od;
        return (String(a.id)).localeCompare(String(b.id));
      });
      return rows;
    }

    // LIVE mode sort:
    // - true live: live score desc, then total desc, then league order
    // - interim: total desc, then league order (still display live play/yet + live score)
    rows.sort(function(a,b){
      if(hasTrueLive){
        var d1 = (toNum(b.score,0) - toNum(a.score,0));
        if(d1) return d1;
        var d2 = (toNum(b.total,0) - toNum(a.total,0));
        if(d2) return d2;
        var od1 = safeFrOrderIndex(a.id) - safeFrOrderIndex(b.id);
        if(od1) return od1;
        return (String(a.id)).localeCompare(String(b.id));
      } else {
        var t = (toNum(b.total,0) - toNum(a.total,0));
        if(t) return t;
        var od2 = safeFrOrderIndex(a.id) - safeFrOrderIndex(b.id);
        if(od2) return od2;
        return (String(a.id)).localeCompare(String(b.id));
      }
    });

    return rows;
  }

  /* =========================
     SLOTS (derived from live starters)
     ========================= */
  function buildSlotsForFranchise(fid){
    var live = state.liveByFranchiseId[fid];
    if(!live) return [];

    var starters = (live.starters || []).map(function(lp){
      var p = state.playerById[lp.playerId] || { id: lp.playerId, name: lp.playerId, pos:"", team:"" };
      var fullName = p.name || lp.playerId;
      return {
        playerId: lp.playerId,
        name: formatPlayerShort(fullName),
        pos: normalizePos(p.pos || ""),
        team: (p.team || "").toUpperCase(),
        points: toNum(lp.points || 0, 0),
        live: toNum(lp.gameSecondsRemaining || 0, 0) > 0
      };
    });

    function takeBest(pos, n, remaining){
      var picked = [];
      for(var i=0;i<n;i++){
        var idx = -1, best = -999999;
        for(var j=0;j<remaining.length;j++){
          if(remaining[j].pos !== pos) continue;
          if(remaining[j].points > best){
            best = remaining[j].points;
            idx = j;
          }
        }
        if(idx >= 0) picked.push(remaining.splice(idx,1)[0]);
        else picked.push(null);
      }
      return picked;
    }

    var rem = starters.slice();
    var qb = takeBest("QB", 1, rem)[0];
    var rbs = takeBest("RB", 2, rem);
    var wrs = takeBest("WR", 2, rem);
    var te  = takeBest("TE", 1, rem)[0];
    var k   = takeBest("K",  1, rem)[0];
    var def = takeBest("DEF",1, rem)[0];

    var flex = null, flexIdx = -1, flexBest = -999999;
    for(var x=0;x<rem.length;x++){
      if(rem[x].pos === "RB" || rem[x].pos === "WR" || rem[x].pos === "TE"){
        if(rem[x].points > flexBest){
          flexBest = rem[x].points;
          flexIdx = x;
        }
      }
    }
    if(flexIdx >= 0) flex = rem.splice(flexIdx,1)[0];

    function slotObj(key, label, player){
      return {
        key:key,
        label:label,
        playerId: player ? player.playerId : "",
        playerName: player ? player.name : "—",
        team: player ? (player.team || "") : "",
        points: player ? toNum(player.points || 0, 0) : 0,
        live: player ? !!player.live : false,
        pos: player ? (player.pos || "") : ""
      };
    }

    var flexLabel = "FLEX";
    if(flex && flex.pos) flexLabel = "FLEX (" + flex.pos + ")";

    return [
      slotObj("QB",  "QB", qb),
      slotObj("RB1", "RB1", rbs[0]),
      slotObj("RB2", "RB2", rbs[1]),
      slotObj("WR1", "WR1", wrs[0]),
      slotObj("WR2", "WR2", wrs[1]),
      slotObj("FLEX", flexLabel, flex),
      slotObj("TE",  "TE", te),
      slotObj("K",   "K", k),
      slotObj("DEF", "DEF", def)
    ];
  }

  /* =========================
     RENDER: LEADERBOARD
     ========================= */
  function renderLeaderboard(rows){
    elLeaderboard.innerHTML = "";

    var updatedAt = (state.viewMode === "TOTAL") ? state.totalsLastLoadedAt : state.lastLiveGoodAt;
    if(updatedAt){
      var d = new Date(updatedAt);
      elLastUpdated.textContent = "Updated " + d.toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"});
    } else {
      elLastUpdated.textContent = "—";
    }

    var anyNonZeroTotals = false;
    rows.forEach(function(r){
      if(toNum(r.total,0) > 0.0001) anyNonZeroTotals = true;
    });

    // Calculate TOTAL rankings for gold/silver/bronze in LIVE view
    var totalRankMap = {};
    if(state.viewMode === "LIVE"){
      var allIds = Object.keys(state.franchiseById);
      var totalRows = allIds.map(function(id){
        var fr = state.franchiseById[id];
        var tscore = toNum((state.totalByFranchiseId && state.totalByFranchiseId[id]) || 0, 0);
        return { id: id, totalScore: tscore };
      });
      totalRows.sort(function(a,b){
        var d = (toNum(b.totalScore,0) - toNum(a.totalScore,0));
        if(d) return d;
        var od = safeFrOrderIndex(a.id) - safeFrOrderIndex(b.id);
        if(od) return od;
        return (String(a.id)).localeCompare(String(b.id));
      });
      totalRows.forEach(function(tr, i){
        totalRankMap[tr.id] = i + 1;
      });
    }

    rows.forEach(function(r, idx){
      var rank = idx + 1;
      var isActive = (r.id === state.selectedFranchiseId);
      var isMe = (r.id === VIEWER_FRANCHISE_ID);

      var medalClass = "";
      if(state.viewMode === "LIVE"){
        var totalRank = totalRankMap[r.id] || 999;
        if(totalRank === 1) medalClass = " kkGold";
        else if(totalRank === 2) medalClass = " kkSilver";
        else if(totalRank === 3) medalClass = " kkBronze";
      } else {
        // In TOTAL view, apply same medal styling
        if(rank === 1) medalClass = " kkGold";
        else if(rank === 2) medalClass = " kkSilver";
        else if(rank === 3) medalClass = " kkBronze";
      }

      var row = document.createElement("div");
      row.className =
        "kkRow" +
        (isActive ? " kkActive" : "") +
        medalClass +
        (isMe ? " kkMe" : "");

      row.onclick = function(){
        state.selectedFranchiseId = r.id;
        if(isMobile()) showDrawer(true);
        render();
      };

      var wm = r.icon ? ('style="background-image:url(\'' + String(r.icon).replace(/'/g,"%27") + '\')"' ) : "";

      var mini = (state.viewMode === "LIVE")
        ? '<div class="kkMiniMeta"><b>'+toNum(r.playing,0)+'</b> play • <b>'+toNum(r.yet,0)+'</b> yet</div>'
        : '<div class="kkMiniMeta">Season total</div>';

      row.innerHTML =
        '<div class="kkRankTile">' +
          '<div class="kkWM" '+wm+'></div>' +
          '<div class="kkRankNum">'+rank+'</div>' +
        '</div>' +
        '<div class="kkText">' +
          '<div class="kkFrName">'+escapeHtml(r.name || r.id)+'</div>' +
          '<div class="kkOwner">'+escapeHtml(r.owner || "")+'</div>' +
        '</div>' +
        '<div class="kkScoreCluster">' +
          '<div class="kkPts">'+fmtPts(toNum(r.score,0))+'</div>' +
          mini +
        '</div>';

      elLeaderboard.appendChild(row);
    });

    if(!rows.length){
      elLeaderboard.innerHTML = '<div style="padding:14px;color:rgba(242,238,230,.65);">No teams found.</div>';
      return;
    }

    if(state.viewMode === "TOTAL" && !anyNonZeroTotals){
      elLeaderboard.insertAdjacentHTML(
        "afterbegin",
        '<div style="padding:10px 10px 0 10px;color:rgba(242,238,230,.75);font-size:12px;">Totals are <b>0.00</b> for everyone. This typically means <b>APIKEY is required</b> for weeklyResults in this embed.</div>'
      );
    }
  }

