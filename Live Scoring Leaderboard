  function deltaClass(d){
    if(d > 0.005) return "pos";
    if(d < -0.005) return "neg";
    return "zero";
  }

  function makeBlankSlots(){
    return [
      {key:"QB",label:"QB",playerName:"—",team:"",points:0,live:false,pos:""},
      {key:"RB1",label:"RB1",playerName:"—",team:"",points:0,live:false,pos:""},
