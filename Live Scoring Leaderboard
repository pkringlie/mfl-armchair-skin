      {key:"DEF",label:"DEF",playerName:"—",team:"",points:0,live:false,pos:""}
    ];
  }

  function byKey(arr){
    var m = {};
    for(var i=0;i<arr.length;i++) m[arr[i].key] = arr[i];
    return m;
  }

